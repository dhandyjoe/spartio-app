# Editor / OS
.DS_Store
Thumbs.db
*.swp

# Per-editor settings (machine-specific; the old tasks.json hardcoded a local path)
.vscode/

# Test & tooling artifacts
playwright-report/
test-results/
blob-report/
coverage/
.playwright-mcp/

# Firebase CLI caches and debug logs
.firebase/
*.log

# Environment files (never commit secrets)
.env
.env.*
!.env.example

# Installed agent skills (third-party; reinstall via the `skills` CLI.
# skills-lock.json stays tracked so the pinned versions are recorded).
.agents/skills/

# Design-skill scratch (screenshots + reports; local only)
.taste-skill/

# Deploy staging (produced by .github/workflows/deploy.yml)
_site/

# Screenshot / debug artifacts (never commit these)
*.png
!assets/**/*.png
*.jpg
pdf-layout-check.png
tests/Pasted*

# Dependencies (if ever added)
node_modules/

# Local OpenCode config (contains Stitch MCP credentials)
opencode.json
