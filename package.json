{
   "name": "spartio-app",
   "private": true,
   "description": "Spartio.app, a static chord and number score builder.",
   "engines": {
      "node": ">=20"
   },
   "scripts": {
      "serve:test": "node tests/e2e/server.mjs",
      "test": "npm run test:unit && npm run test:playback && npm run test:e2e",
      "test:unit": "node --test tests/unit.test.mjs",
      "test:playback": "node --test tests/playback.test.mjs",
      "test:e2e": "playwright test",
      "test:e2e:headed": "playwright test --headed",
      "test:e2e:ui": "playwright test --ui"
   },
   "devDependencies": {
      "@playwright/test": "1.64.1"
   }
}
